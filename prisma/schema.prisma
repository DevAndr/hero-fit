generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Справочники ─────────────────────────────

enum MuscleGroup {
  CHEST // Грудь
  LEGS // Ноги
  SHOULDERS // Плечи
  FOREARMS // Предплечья
  CALVES // Икры
  TRICEPS // Трицепс
  BICEPS // Бицепс
  BACK // Спина
  TRAPS // Трапеция
  ABS // Пресс
}

enum WorkoutStatus {
  PLANNED // собрана, но не запущена
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecordType {
  ONE_RM // расчётный 1RM по Эпли
  MAX_WEIGHT
  MAX_REPS
}

enum AchievementCategory {
  WORKOUT_COUNT // кол-во тренировок, кратное 5
  STREAK // «в ударе»
  WEIGHT_PROGRESS // прогрессия веса в упражнении
  SET_VOLUME // > 4 подходов в упражнении
  DAILY_LOGIN // вход в приложение каждый день
  VOLUME // тоннаж и повторы
  RECORDS // побитые личные рекорды
  STRENGTH // круглые веса и сила относительно веса тела в базовых упражнениях
  VARIETY // разнообразие: упражнения, группы мышц
  TIME // часы в зале, длительность, время суток, регулярность по неделям
  PROGRAMS // свои шаблоны и готовые программы
  MILESTONE // уровни, коллекция ачивок, возвращение, спасённый streak
  LEAGUE // места в недельной лиге друзей (из итогов недели)
}

enum NotificationType {
  REST // таймер отдыха закончился
  STREAK // «Не потеряй streak!»
  ACHIEVEMENT
  SYSTEM // тестовые и служебные
  SOCIAL // друзья: заявки и принятие
  PLAN // «Сегодня по плану»
  RECAP // «Итоги недели» и «Новый старт»
}

enum FriendshipStatus {
  PENDING // заявка отправлена, ждёт ответа
  ACCEPTED
}

enum XpReason {
  WORKOUT_COMPLETED
  PERSONAL_RECORD
  ACHIEVEMENT
  STREAK_BONUS
  DAILY_LOGIN
  STREAK_RESTORE // выкуп сгоревшей серии (отрицательная сумма)
}

// ───────────────────────────── Пользователь и авторизация ─────────────────────────────

model User {
  id           String  @id @default(cuid())
  login        String  @unique
  email        String  @unique
  passwordHash String
  name         String?
  bodyWeight   Float? // кг; для ачивок «1RM к весу тела»
  /// IANA-пояс из cookie hf_tz (обновляется при входе): время суток и недели в ачивках
  timeZone     String  @default("UTC")

  // Рейтинг: публичный ник (логин никому не показываем) и личный код для приглашения в друзья.
  nickname    String?
  nicknameKey String? @unique // ник в нижнем регистре — уникальность без учёта регистра
  friendCode  String? @unique

  // Лента активности: видят только друзья. Настройки применяются при чтении — действуют и на прошлые тренировки.
  shareActivity Boolean @default(true) // показывать мои тренировки друзьям
  hideWeights   Boolean @default(false) // скрывать рабочие веса и объём (длительность и рекорды видны)

  // Прогресс
  xp    Int @default(0) // суммарный XP за всё время; уровень вычисляется из него
  level Int @default(1) // денормализовано для быстрых выборок

  // Streak «в ударе» — недели подряд с 3+ тренировками (lib/progress/weekly-streak.ts)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  streakFreezes   Int       @default(1) // доступные заморозки
  freezeGrantedAt DateTime? // когда последний раз выдана плановая заморозка (раз в 4 недели)
  streakRestoredAt DateTime? // когда последний раз выкупили сгоревшую серию (повторно — только после новой засчитанной недели)
  // Неделя — «YYYY-MM-DD» понедельника в поясе пользователя
  lastStreakWeek  String? // последняя засчитанная неделя
  weekWorkouts    Int     @default(0) // тренировок за неделю weekWorkoutsKey (для шапки без лишнего SQL)
  weekWorkoutsKey String?

  // Ежедневный вход
  loginStreak  Int       @default(0)
  lastLoginDay DateTime? @db.Date

  // Уведомления
  notifyRest         Boolean   @default(true)
  notifyStreak       Boolean   @default(true)
  notifyAchievements Boolean   @default(true)
  notifySocial       Boolean   @default(true)
  notifyPlan         Boolean   @default(true)
  notifyRecap        Boolean   @default(true)
  /// за сколько минут до плана напоминать: 15 | 30 | 60 | 120
  planReminderMin    Int       @default(60)
  /// локальная дата последнего «Не потеряй streak!» (не чаще раза в день)
  streakReminderDay  String?
  /// неделя (пн), за которую уже ушёл push «Новая неделя — новый старт»
  recapNudgeWeek     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  exercises           Exercise[]
  templates           WorkoutTemplate[]
  workouts            Workout[]
  personalRecords     PersonalRecord[]
  achievements        UserAchievement[]
  xpEvents            XpEvent[]
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  scheduledPushes     ScheduledPush[]
  streakCoverWeeks    StreakCoverWeek[]
  planSeries          PlanSeries[]
  planEntries         PlanEntry[]
  planReminders       PlanReminder[]
  weeklyRecaps        WeeklyRecap[]
  friendRequestsSent  Friendship[]         @relation("FriendshipRequester")
  friendRequestsGot   Friendship[]         @relation("FriendshipAddressee")
  kudos               Kudos[]
}

/// Дружба взаимная: заявка → принятие. Принятая дружба = согласие показывать другу ник и недельный XP.
/// Отклонение и удаление — просто удаление строки.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

/// Сессия = семейство refresh-токенов одного устройства.
/// revokedAt ≠ null — сессия в blacklist (logout или обнаружен повторный refresh).
model Session {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Храним только SHA-256 хеш токена. При ротации старый токен помечается usedAt;
/// повторное использование уже использованного токена → отзыв всей сессии.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Упражнения ─────────────────────────────

/// userId = null — встроенное упражнение (доступно всем, не редактируется).
model Exercise {
  id             String        @id @default(cuid())
  userId         String?
  name           String
  description    String?
  muscleGroups   MuscleGroup[] // первая — основная
  isBodyweight   Boolean       @default(false)
  defaultRestSec Int           @default(90)
  archivedAt     DateTime? // «удалённое» упражнение — скрыто, но история тренировок сохраняется
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateExercises TemplateExercise[]
  workoutExercises  WorkoutExercise[]
  personalRecords   PersonalRecord[]
  achievements      UserAchievement[]

  @@unique([userId, name])
  @@index([userId])
}

// ───────────────────────────── Шаблоны и программы ─────────────────────────────

/// userId = null — готовая программа (Push/Pull/Legs, Full Body, 5×5).
model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
  program     String? // группировка дней одной программы, напр. "PPL"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user      User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises   TemplateExercise[]
  workouts    Workout[]
  planSeries  PlanSeries[]
  planEntries PlanEntry[]

  @@index([userId])
}

model TemplateExercise {
  id           String @id @default(cuid())
  templateId   String
  exerciseId   String
  order        Int
  targetSets   Int    @default(3)
  targetReps   Int?
  targetWeight Float?
  restSec      Int?

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([templateId])
}

// ───────────────────────────── Тренировки ─────────────────────────────

model Workout {
  id          String        @id @default(cuid())
  userId      String
  templateId  String?
  /// ключ вхождения календаря, из которого запущена тренировка (lib/plans/expand.ts)
  planKey     String?
  name        String
  status      WorkoutStatus @default(PLANNED)
  startedAt   DateTime?
  finishedAt  DateTime?
  durationSec Int? // finishedAt - startedAt, фиксируется при завершении
  totalVolume Float         @default(0) // Σ вес × повторы
  totalSets   Int           @default(0)
  totalReps   Int           @default(0)
  xpEarned    Int           @default(0)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template  WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  exercises WorkoutExercise[]
  xpEvents  XpEvent[]
  kudos     Kudos[]

  @@index([userId, status])
  @@index([userId, finishedAt])
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int
  restSec    Int    @default(90)

  workout  Workout      @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String    @id @default(cuid())
  workoutExerciseId String
  order             Int
  weight            Float     @default(0) // кг; 0 для упражнений с собственным весом
  reps              Int
  isWarmup          Boolean   @default(false)
  /// Запас повторов (Reps In Reserve): 0 — до отказа … 4 — «4 и больше»; null — не указан
  rir               Int?
  completedAt       DateTime?

  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecords PersonalRecord[]

  @@index([workoutExerciseId])
}

// ───────────────────────────── Прогресс ─────────────────────────────

/// Текущий лучший результат по типу рекорда; история — через WorkoutSet.
model PersonalRecord {
  id         String     @id @default(cuid())
  userId     String
  exerciseId String
  type       RecordType
  value      Float
  setId      String?
  achievedAt DateTime   @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  set      WorkoutSet? @relation(fields: [setId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId, type])
}

/// Ачивки генерируются динамически: code уникален в рамках пользователя,
/// напр. "workouts:25", "streak:7", "weightkg:<exerciseId>:10", "sets:<exerciseId>", "login:30".
model UserAchievement {
  id          String              @id @default(cuid())
  userId      String
  code        String
  category    AchievementCategory
  title       String
  description String
  threshold   Int
  exerciseId  String?
  xpReward    Int                 @default(0)
  earnedAt    DateTime            @default(now())
  seenAt      DateTime? // для уведомления «новая ачивка»

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, earnedAt])
}

/// Журнал начислений XP — источник правды для User.xp.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    XpReason
  workoutId String?
  meta      Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// ───────────────────────────── Уведомления ─────────────────────────────

/// Подписка Web Push одного браузера/устройства.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Лента уведомлений внутри приложения (колокольчик).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Очередь push: отправляет фоновая задача (instrumentation / cron), когда sendAt наступил.
/// key — для замены отложенного уведомления (напр. «rest:<userId>» при +15 сек).
model ScheduledPush {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  key         String?          @unique
  title       String
  body        String
  url         String?
  sendAt      DateTime
  sentAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sendAt])
}

// ───────────────────────────── Лента активности ─────────────────────────────

/// 👊 от друга на завершённую тренировку (запись ленты = тренировка). Один на пару «тренировка–пользователь».
model Kudos {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
}

// ───────────────────────────── Streak ─────────────────────────────

enum StreakCoverReason {
  FREEZE // пропущенную неделю закрыла заморозка
  RESTORE // серию выкупили за XP
}

/// Журнал недель, пропущенных без потери серии.
model StreakCoverWeek {
  id        String            @id @default(cuid())
  userId    String
  week      String // понедельник недели, "YYYY-MM-DD"
  reason    StreakCoverReason
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

// ───────────────────────────── Календарь ─────────────────────────────
// Даты — «YYYY-MM-DD», время — «HH:MM» местного времени пользователя (lib/plans/expand.ts)

/// Повторяющаяся тренировка: каждую неделю в день weekday (0 = пн … 6 = вс).
model PlanSeries {
  id          String   @id @default(cuid())
  userId      String
  templateId  String?
  title       String // название шаблона на момент создания или своё
  weekday     Int
  time        String
  durationMin Int      @default(60)
  startDate   String // первое вхождение не раньше
  endDate     String? // последнее возможное вхождение (включительно)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  entries  PlanEntry[]

  @@index([userId])
}

/// Разовая тренировка или исключение из серии (перенос / отмена одной даты).
model PlanEntry {
  id           String   @id @default(cuid())
  userId       String
  seriesId     String?
  originalDate String? // дата вхождения серии, которое заменяет запись
  templateId   String?
  title        String
  date         String
  time         String
  durationMin  Int      @default(60)
  cancelled    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  series   PlanSeries?      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([seriesId, originalDate])
  @@index([userId, date])
}

/// Напоминание «Сегодня по плану» по вхождению отправлено (одно на вхождение).
model PlanReminder {
  id      String   @id @default(cuid())
  userId  String
  planKey String
  sentAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planKey])
}

/// Снимок итогов недели. data — RecapData (lib/recap/types.ts) с полем version.
model WeeklyRecap {
  id        String    @id @default(cuid())
  userId    String
  week      String // понедельник недели "YYYY-MM-DD" в поясе пользователя
  data      Json
  createdAt DateTime  @default(now())
  pushedAt  DateTime? // push «Итоги недели» отправлен
  seenAt    DateTime? // пользователь открыл страницу итогов

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}
