generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Справочники ─────────────────────────────

enum MuscleGroup {
  CHEST // Грудь
  LEGS // Ноги
  SHOULDERS // Плечи
  FOREARMS // Предплечья
  CALVES // Икры
  TRICEPS // Трицепс
  BICEPS // Бицепс
  BACK // Спина
  TRAPS // Трапеция
  ABS // Пресс
}

/// Самочувствие перед тренировкой (чек-ин умного помощника)
enum Wellbeing {
  GREAT // Отлично
  OK // Нормально
  TIRED // Устал
}

enum WorkoutStatus {
  PLANNED // собрана, но не запущена
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RecordType {
  ONE_RM // расчётный 1RM по Эпли
  MAX_WEIGHT
  MAX_REPS
  MAX_DURATION // самый долгий подход (на время, кардио), с
  MAX_DISTANCE // самый длинный подход кардио, м
  BEST_PACE // лучший темп кардио, с/км — меньше лучше (подходы от 1 км)
}

/// Вид упражнения: силовое (вес × повторы), на время (подход — секунды), кардио (время + дистанция)
enum ExerciseKind {
  REPS
  TIME
  CARDIO
}

enum AchievementCategory {
  WORKOUT_COUNT // кол-во тренировок, кратное 5
  STREAK // «в ударе»
  WEIGHT_PROGRESS // прогрессия веса в упражнении
  SET_VOLUME // > 4 подходов в упражнении
  DAILY_LOGIN // вход в приложение каждый день
  VOLUME // тоннаж и повторы
  RECORDS // побитые личные рекорды
  STRENGTH // круглые веса и сила относительно веса тела в базовых упражнениях
  VARIETY // разнообразие: упражнения, группы мышц
  TIME // часы в зале, длительность, время суток, регулярность по неделям
  PROGRAMS // свои шаблоны и готовые программы
  MILESTONE // уровни, коллекция ачивок, возвращение, спасённый streak
  LEAGUE // места в недельной лиге друзей (из итогов недели)
  BOSS // победы над боссом недели
  CLUB // задания клуба зала
  GUILD // победы в рейдах гильдии
  GOAL // выполненные личные цели (lib/goals)
  COACH // ачивки тренера (lib/achievements/coach-stats.ts)
  ENDURANCE // кардио и упражнения на время
  SOCIAL // социальное: респекты за рекорды
}

enum NotificationType {
  REST // таймер отдыха закончился
  STREAK // «Не потеряй streak!»
  ACHIEVEMENT
  SYSTEM // тестовые и служебные
  SOCIAL // друзья: заявки и принятие
  PLAN // «Сегодня по плану»
  RECAP // «Итоги недели» и «Новый старт»
  BOSS // босс недели повержен
  RAID // рейд-босс гильдии: повержен, «не хватает урона»
  COACH // тренер: новый клиент, клиент ушёл, тренер завершил работу
  GOAL // личные цели: выполнена, 7 дней до срока, срок вышел
  FEEDBACK // обратная связь: обращение сделано или отклонено
}

enum FriendshipStatus {
  PENDING // заявка отправлена, ждёт ответа
  ACCEPTED
}

enum XpReason {
  WORKOUT_COMPLETED
  PERSONAL_RECORD
  ACHIEVEMENT
  STREAK_BONUS
  DAILY_LOGIN
  STREAK_RESTORE // выкуп сгоревшей серии (отрицательная сумма)
  BOSS_REWARD // сундук за победу над боссом недели (lib/boss)
  RAID_REWARD // сундук рейда гильдии (lib/raid)
  GOAL_REWARD // сундук за выполненную цель (lib/goals)
  CLUB_TASK_REWARD // сундук за задание клуба (lib/club/tasks)
  GOBLIN_REWARD // сундук Золотого гоблина (lib/goblin)
}

// ───────────────────────────── Пользователь и авторизация ─────────────────────────────

model User {
  /// id последнего просмотренного релиза «Что нового» (lib/changelog/releases.ts); null — не смотрел
  changelogSeen     String?
  /// монеты магазина (lib/shop): баланс и момент, с которого они считаются; журнал — CoinTx
  coins             Int       @default(0)
  coinsSince        DateTime  @default(now())
  /// надетая косметика (код из каталога lib/shop); null — по умолчанию
  avatarCode        String?
  frameCode         String?
  nickColorCode     String?
  themeCode         String?
  coinTxs           CoinTx[]
  whoopConnection   WhoopConnection?
  whoopWorkouts     WhoopWorkout[]
  whoopSleeps       WhoopSleep[]
  items             UserItem[]
  /// умный помощник (флаг smart_coach): выключается в /settings
  assistantEnabled  Boolean   @default(true)
  id                String    @id @default(cuid())
  login             String    @unique
  /// null — аккаунт из Telegram Mini App (email и пароль задаются в «Вход на сайте»)
  email             String?   @unique
  passwordHash      String?
  name              String?
  bodyWeight        Float? // кг; для ачивок «1RM к весу тела»
  /// IANA-пояс из cookie hf_tz (обновляется при входе): время суток и недели в ачивках
  timeZone          String    @default("UTC")
  /// Согласие на обработку персональных данных (галочка при регистрации); null — зарегистрирован до неё
  privacyAcceptedAt DateTime?
  /// Экскурсия по дашборду завершена (любым способом); null — показать на дашборде
  onboardedAt       DateTime?

  // Рейтинг: публичный ник (логин никому не показываем) и личный код для приглашения в друзья.
  nickname    String?
  nicknameKey String? @unique // ник в нижнем регистре — уникальность без учёта регистра
  friendCode  String? @unique

  // Режим тренера: раздел «Клиенты» и личный код приглашения (формат как у friendCode)
  isCoach   Boolean @default(false)
  coachCode String? @unique
  titleCode String? // выбранный титул (lib/titles/catalog.ts); доступные вычисляются, не хранятся

  // Лента активности: видят только друзья. Настройки применяются при чтении — действуют и на прошлые тренировки.
  shareActivity Boolean @default(true) // показывать мои тренировки друзьям
  hideWeights   Boolean @default(false) // скрывать рабочие веса и объём (длительность и рекорды видны)

  // Прогресс
  xp    Int @default(0) // суммарный XP за всё время; уровень вычисляется из него
  level Int @default(1) // денормализовано для быстрых выборок

  // Streak «в ударе» — недели подряд с 3+ тренировками (lib/progress/weekly-streak.ts)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  streakFreezes    Int       @default(1) // доступные заморозки
  freezeGrantedAt  DateTime? // когда последний раз выдана плановая заморозка (раз в 4 недели)
  streakRestoredAt DateTime? // когда последний раз выкупили сгоревшую серию (повторно — только после новой засчитанной недели)
  // Неделя — «YYYY-MM-DD» понедельника в поясе пользователя
  lastStreakWeek   String? // последняя засчитанная неделя
  weekWorkouts     Int       @default(0) // тренировок за неделю weekWorkoutsKey (для шапки без лишнего SQL)
  weekWorkoutsKey  String?

  // Ежедневный вход
  loginStreak    Int       @default(0)
  lastLoginDay   DateTime? @db.Date
  /// день, за который открыт ежедневный сундук (lib/progress/daily-chest.ts)
  chestOpenedDay DateTime? @db.Date

  // Уведомления
  notifyRest         Boolean   @default(true)
  notifyStreak       Boolean   @default(true)
  notifyAchievements Boolean   @default(true)
  notifySocial       Boolean   @default(true)
  notifyPlan         Boolean   @default(true)
  notifyRecap        Boolean   @default(true)
  notifyGoal         Boolean   @default(true)
  /// Telegram-бот: личный чат (один Telegram — один аккаунт), уведомления дублируются туда, кроме таймера отдыха
  telegramChatId     BigInt?   @unique
  /// вход в Telegram Mini App (id пользователя Telegram) — отдельно от уведомлений: /stop, «Отключить» и 403 его не трогают;
  /// ставится только регистрацией из Mini App или привязкой по паролю, не ссылкой бота
  telegramId         BigInt?   @unique
  telegramUsername   String?
  telegramLinkedAt   DateTime?
  notifyTelegram     Boolean   @default(true)
  /// за сколько минут до плана напоминать: 15 | 30 | 60 | 120
  planReminderMin    Int       @default(60)
  /// локальная дата последнего «Не потеряй streak!» (не чаще раза в день)
  streakReminderDay  String?
  /// день (YYYY-MM-DD в поясе тренера) последней проверки сигналов клиентов
  coachSignalsDay    String?
  /// неделя (пн), за которую уже ушёл push «Новая неделя — новый старт»
  recapNudgeWeek     String?
  /// итоги недели клиентов (тренеру): push и колокольчик
  notifyCoachRecap   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  exercises           Exercise[]
  templates           WorkoutTemplate[]
  workouts            Workout[]
  personalRecords     PersonalRecord[]
  achievements        UserAchievement[]
  xpEvents            XpEvent[]
  pushSubscriptions   PushSubscription[]
  telegramLinkTokens  TelegramLinkToken[]
  notifications       Notification[]
  scheduledPushes     ScheduledPush[]
  streakCoverWeeks    StreakCoverWeek[]
  visits              UserVisit[]
  alertDismissals     SystemAlertDismissal[]
  feedback            Feedback[]
  bossWeeks           BossWeek[]
  planSeries          PlanSeries[]         @relation("PlanSeriesUser")
  planEntries         PlanEntry[]          @relation("PlanEntryUser")
  planReminders       PlanReminder[]
  weeklyRecaps        WeeklyRecap[]
  friendRequestsSent  Friendship[]         @relation("FriendshipRequester")
  friendRequestsGot   Friendship[]         @relation("FriendshipAddressee")
  coachClients        CoachLink[]          @relation("CoachLinkCoach")
  coachLinks          CoachLink[]          @relation("CoachLinkClient")
  coachPlanSeries     PlanSeries[]         @relation("PlanSeriesCoach")
  coachPlanEntries    PlanEntry[]          @relation("PlanEntryCoach")
  coachCommentsGiven  CoachComment[]       @relation("CoachCommentCoach")
  coachCommentsGot    CoachComment[]       @relation("CoachCommentClient")
  coachNotesWritten   CoachNote[]          @relation("CoachNoteCoach")
  coachNotesAbout     CoachNote[]          @relation("CoachNoteClient")
  coachPrograms             CoachProgram[]
  programAssignmentsAsClient ProgramAssignment[] @relation("ProgramAssignmentClient")
  programAssignmentsAsCoach  ProgramAssignment[] @relation("ProgramAssignmentCoach")
  coachTargets        CoachTarget[]
  coachSignals        CoachSignal[]        @relation("CoachSignalCoach")
  coachGroups         CoachGroup[]         @relation("CoachGroupCoach")
  guildLed            Guild[]              @relation("GuildLeader")
  guildMember         GuildMember?         @relation("GuildMember")
  clubsAdmin          Club[]               @relation("ClubAdmin")
  clubMember          ClubMember?          @relation("ClubMember")
  clubBans            ClubBan[]            @relation("ClubBan")
  clubTasksCreated    ClubTask[]           @relation("ClubTaskCreator")
  clubTaskHits        ClubTaskHit[]        @relation("ClubTaskHit")
  clubTaskRewards     ClubTaskReward[]     @relation("ClubTaskReward")
  raidMvp             RaidWeek[]           @relation("RaidMvp")
  raidHits            RaidHit[]
  raidRewards         RaidReward[]
  coachGroupMembers   CoachGroupMember[]   @relation("CoachGroupClient")
  clientSignals       CoachSignal[]        @relation("CoachSignalClient")
  coachRecaps         CoachWeeklyRecap[]
  coachRecapRows      CoachRecapClient[]
  coachProfile        CoachProfile?
  kudos               Kudos[]
  recordRespects      RecordRespect[]
  favoriteExercises   FavoriteExercise[]
  goals               Goal[]
  bodyWeights         BodyWeightEntry[]
  errorEvents         ErrorEvent[]
  goblinEncounters    GoblinEncounter[]
  /// последнее появление Золотого гоблина — пауза 14 дней (не сбрасывается отменой тренировки)
  goblinLastAt        DateTime?
}

/// Дружба взаимная: заявка → принятие. Принятая дружба = согласие показывать другу ник и недельный XP.
/// Отклонение и удаление — просто удаление строки.
model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

/// Тренер ↔ клиент. Активная связь — endedAt = null; у клиента не больше одной
/// (частичный уникальный индекс "CoachLink_active_client" в миграции). Разорванные храним — история.
model CoachLink {
  id        String    @id @default(cuid())
  coachId   String
  clientId  String
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  /// "client" — отключил клиент, "coach" — удалил тренер, "switch" — клиент перешёл к другому тренеру
  endedBy   String?

  coach  User @relation("CoachLinkCoach", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("CoachLinkClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, endedAt])
  @@index([clientId, endedAt])
}

/// Личная заметка тренера о клиенте — видит только тренер; удаляется при разрыве связи (dropAssignments).
model CoachNote {
  coachId   String
  clientId  String
  text      String
  updatedAt DateTime @updatedAt

  coach  User @relation("CoachNoteCoach", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("CoachNoteClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@id([coachId, clientId])
  @@index([clientId])
}

/// Комментарий тренера к завершённой тренировке клиента: общий (workoutExerciseId = null) или к упражнению.
/// Один общий на тренировку — частичный уникальный индекс "CoachComment_workout_general" в миграции (Prisma его не видит).
model CoachComment {
  id                String    @id @default(cuid())
  /// null — аккаунт тренера удалён, комментарий у клиента остаётся
  coachId           String?
  clientId          String
  workoutId         String
  workoutExerciseId String?   @unique
  text              String
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  coach           User?            @relation("CoachCommentCoach", fields: [coachId], references: [id], onDelete: SetNull)
  client          User             @relation("CoachCommentClient", fields: [clientId], references: [id], onDelete: Cascade)
  workout         Workout          @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@index([clientId, readAt])
}

/// Сессия = семейство refresh-токенов одного устройства.
/// revokedAt ≠ null — сессия в blacklist (logout или обнаружен повторный refresh).
model Session {
  id         String    @id @default(cuid())
  userId     String
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  /// создана в Telegram Mini App — cookies для фрейма (SameSite=None; Partitioned)
  embedded   Boolean   @default(false)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId])
}

/// Храним только SHA-256 хеш токена. При ротации старый токен помечается usedAt;
/// повторное использование уже использованного токена → отзыв всей сессии.
model RefreshToken {
  id        String    @id @default(cuid())
  sessionId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Упражнения ─────────────────────────────

/// userId = null — встроенное упражнение (доступно всем, не редактируется).
model Exercise {
  id             String        @id @default(cuid())
  userId         String?
  name           String
  description    String?
  muscleGroups   MuscleGroup[] // первая — основная
  isBodyweight   Boolean       @default(false)
  kind           ExerciseKind  @default(REPS)
  defaultRestSec Int           @default(90)
  archivedAt     DateTime? // «удалённое» упражнение — скрыто, но история тренировок сохраняется
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user              User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateExercises TemplateExercise[]
  workoutExercises  WorkoutExercise[]
  personalRecords   PersonalRecord[]
  achievements      UserAchievement[]
  coachTargets      CoachTarget[]
  goals             Goal[]
  clubTasks         ClubTask[]
  recordRespects    RecordRespect[]
  favorites         FavoriteExercise[]

  @@unique([userId, name])
  @@index([userId])
}

// ───────────────────────────── Шаблоны и программы ─────────────────────────────

/// userId = null — готовая программа (Push/Pull/Legs, Full Body, 5×5).
model WorkoutTemplate {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?
  program     String? // группировка дней одной программы, напр. "PPL"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises    TemplateExercise[]
  workouts     Workout[]
  planSeries   PlanSeries[]
  planEntries  PlanEntry[]
  coachTargets CoachTarget[]
  programDays  CoachProgramDay[]

  @@index([userId])
}

model TemplateExercise {
  id           String @id @default(cuid())
  templateId   String
  exerciseId   String
  order        Int
  targetSets   Int    @default(3)
  targetReps   Int?
  targetWeight Float?
  restSec      Int?
  /// своя прогрессия: шаг, кг (0,5…20); работает при заданном targetWeight
  step         Float?
  /// неудач подряд (своя прогрессия): на 3-й — разгрузка −10 %
  fails        Int    @default(0)
  /// суперсет/круг: соседние упражнения с одним номером; null — вне группы
  supersetGroup Int?

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([templateId])
}

// ───────────────────────────── Тренировки ─────────────────────────────

model Workout {
  id                 String        @id @default(cuid())
  userId             String
  templateId         String?
  /// ключ вхождения календаря, из которого запущена тренировка (lib/plans/expand.ts)
  planKey            String?
  name               String
  status             WorkoutStatus @default(PLANNED)
  startedAt          DateTime?
  finishedAt         DateTime?
  durationSec        Int? // finishedAt - startedAt, фиксируется при завершении
  totalVolume        Float         @default(0) // Σ вес × повторы
  totalSets          Int           @default(0)
  totalReps          Int           @default(0)
  xpEarned           Int           @default(0)
  /// тяжесть тренировки 1–10 (оценка в сводке, lib/workouts/feedback.ts)
  rpe                Int?
  /// заметка к оценке тренировки
  notes              String?
  /// самочувствие из чек-ина помощника; боль сюда не пишется (152-ФЗ — только на устройстве)
  wellbeing          Wellbeing?
  /// когда тренеру ушло уведомление об оценке (одно на тренировку)
  feedbackNotifiedAt DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  template     WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  exercises    WorkoutExercise[]
  xpEvents     XpEvent[]
  kudos        Kudos[]
  recordRespects RecordRespect[]
  comments     CoachComment[]
  raidHit      RaidHit?
  clubTaskHits ClubTaskHit[]
  goblin       GoblinEncounter?
  /// Золотой гоблин: до скольких выполненных рабочих подходов уже бросали (повторная отметка не даёт броска)
  goblinRolledSets Int @default(0)

  @@index([userId, status])
  @@index([userId, finishedAt])
}

model WorkoutExercise {
  id         String @id @default(cuid())
  workoutId  String
  exerciseId String
  order      Int
  restSec    Int    @default(90)
  /// суперсет/круг: соседние упражнения с одним номером (lib/workouts/supersets.ts); null — вне группы
  supersetGroup Int?

  workout  Workout       @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sets     WorkoutSet[]
  comment  CoachComment?

  @@index([workoutId])
  @@index([exerciseId])
}

model WorkoutSet {
  id                String    @id @default(cuid())
  workoutExerciseId String
  order             Int
  weight            Float     @default(0) // кг; 0 для упражнений с собственным весом
  reps              Int
  isWarmup          Boolean   @default(false)
  /// Запас повторов (Reps In Reserve): 0 — до отказа … 4 — «4 и больше»; null — не указан
  rir               Int?
  /// подход на время/кардио: время, с (reps и weight — 0)
  durationSec       Int?
  /// подход кардио: дистанция, м
  distanceM         Int?
  completedAt       DateTime?

  workoutExercise WorkoutExercise  @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  personalRecords PersonalRecord[]

  @@index([workoutExerciseId])
}

// ───────────────────────────── Прогресс ─────────────────────────────

/// Текущий лучший результат по типу рекорда; история — через WorkoutSet.
model PersonalRecord {
  id         String     @id @default(cuid())
  userId     String
  exerciseId String
  type       RecordType
  value      Float
  setId      String?
  achievedAt DateTime   @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise    @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  set      WorkoutSet? @relation(fields: [setId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseId, type])
}

/// Ачивки генерируются динамически: code уникален в рамках пользователя,
/// напр. "workouts:25", "streak:7", "weightkg:<exerciseId>:10", "sets:<exerciseId>", "login:30".
model UserAchievement {
  id          String              @id @default(cuid())
  userId      String
  code        String
  category    AchievementCategory
  title       String
  description String
  threshold   Int
  exerciseId  String?
  xpReward    Int                 @default(0)
  earnedAt    DateTime            @default(now())
  seenAt      DateTime? // для уведомления «новая ачивка»

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, earnedAt])
}

/// Журнал начислений XP — источник правды для User.xp.
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    XpReason
  workoutId String?
  meta      Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum CoinReason {
  WORKOUT
  RECORD
  DAILY_CHEST
  BOSS_CHEST
  RAID_CHEST
  GOAL_CHEST
  CLUB_TASK_CHEST
  GOBLIN_CHEST
  ACHIEVEMENT
  STREAK_WEEK
  LEVEL_UP
  RETRO // стартовый баланс при выходе магазина
  PURCHASE // покупка (отрицательная сумма)
}

/// Журнал монет — источник правды для User.coins; `key` делает начисление идемпотентным.
model CoinTx {
  id        String     @id @default(cuid())
  userId    String
  amount    Int
  reason    CoinReason
  key       String
  meta      Json?
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, reason, createdAt])
  @@index([userId, createdAt])
}

/// Купленная косметика (код из каталога lib/shop).
model UserItem {
  id         String   @id @default(cuid())
  userId     String
  code       String
  source     String
  acquiredAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
}

// ───────────────────────────── Уведомления ─────────────────────────────

/// Подписка Web Push одного браузера/устройства.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Лента уведомлений внутри приложения (колокольчик).
model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Очередь push: отправляет фоновая задача (instrumentation / cron), когда sendAt наступил.
/// key — для замены отложенного уведомления (напр. «rest:<userId>» при +15 сек).
model ScheduledPush {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  key         String?          @unique
  title       String
  body        String
  url         String?
  sendAt      DateTime
  sentAt      DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sendAt])
}

// ───────────────────────────── Лента активности ─────────────────────────────

/// 👊 от друга на завершённую тренировку (запись ленты = тренировка). Один на пару «тренировка–пользователь».
model Kudos {
  id        String   @id @default(cuid())
  workoutId String
  userId    String
  createdAt DateTime @default(now())

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, userId])
}

/// ★ Избранное упражнение пользователя (встроенное или своё) — сверху в списках, чип «Избранное».
model FavoriteExercise {
  userId     String
  exerciseId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@index([exerciseId])
}

/// 🏆 от друга/согильдийца на рекорд в упражнении тренировки. Один на тройку «тренировка–упражнение–пользователь».
model RecordRespect {
  id         String   @id @default(cuid())
  workoutId  String
  exerciseId String
  userId     String // кто поставил
  createdAt  DateTime @default(now())

  workout  Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workoutId, exerciseId, userId])
  @@index([exerciseId])
}

// ───────────────────────────── Streak ─────────────────────────────

enum StreakCoverReason {
  FREEZE // пропущенную неделю закрыла заморозка
  RESTORE // серию выкупили за XP
}

/// Журнал недель, пропущенных без потери серии.
model StreakCoverWeek {
  id        String            @id @default(cuid())
  userId    String
  week      String // понедельник недели, "YYYY-MM-DD"
  reason    StreakCoverReason
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

// ───────────────────────────── Календарь ─────────────────────────────
// Даты — «YYYY-MM-DD», время — «HH:MM» местного времени пользователя (lib/plans/expand.ts)

/// Повторяющаяся тренировка: каждую неделю в день weekday (0 = пн … 6 = вс).
model PlanSeries {
  id          String   @id @default(cuid())
  userId      String
  templateId  String?
  title       String // название шаблона на момент создания или своё
  weekday     Int
  time        String
  durationMin Int      @default(60)
  startDate   String // первое вхождение не раньше
  endDate     String? // последнее возможное вхождение (включительно)
  /// назначил тренер (режим тренера, этап 2); null — свой план
  coachId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User             @relation("PlanSeriesUser", fields: [userId], references: [id], onDelete: Cascade)
  coach    User?            @relation("PlanSeriesCoach", fields: [coachId], references: [id], onDelete: SetNull)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  entries  PlanEntry[]
  /// серия программы тренера на несколько недель (lib/coach/program.ts)
  programAssignmentId String?
  programAssignment   ProgramAssignment? @relation(fields: [programAssignmentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, coachId])
  @@index([programAssignmentId])
}

/// Разовая тренировка или исключение из серии (перенос / отмена одной даты).
model PlanEntry {
  id           String   @id @default(cuid())
  userId       String
  seriesId     String?
  originalDate String? // дата вхождения серии, которое заменяет запись
  templateId   String?
  title        String
  date         String
  time         String
  durationMin  Int      @default(60)
  cancelled    Boolean  @default(false)
  /// назначил тренер (у разовой); у исключения серии не читается — принадлежность по серии
  coachId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user     User             @relation("PlanEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  coach    User?            @relation("PlanEntryCoach", fields: [coachId], references: [id], onDelete: SetNull)
  series   PlanSeries?      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  template WorkoutTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([seriesId, originalDate])
  @@index([userId, date])
  @@index([userId, coachId])
}

/// Напоминание «Сегодня по плану» по вхождению отправлено (одно на вхождение).
model PlanReminder {
  id      String   @id @default(cuid())
  userId  String
  planKey String
  sentAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planKey])
}

/// Снимок итогов недели. data — RecapData (lib/recap/types.ts) с полем version.
model WeeklyRecap {
  id        String    @id @default(cuid())
  userId    String
  week      String // понедельник недели "YYYY-MM-DD" в поясе пользователя
  data      Json
  createdAt DateTime  @default(now())
  pushedAt  DateTime? // push «Итоги недели» отправлен
  seenAt    DateTime? // пользователь открыл страницу итогов

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

// ───────────────────────────── Босс недели ─────────────────────────────

/// Босс недели пользователя (lib/boss). Урон не хранится — считается из подходов недели.
model BossWeek {
  id             String    @id @default(cuid())
  userId         String
  /// дата понедельника в поясе пользователя, как lastStreakWeek
  week           String
  bossCode       String
  hp             Int
  defeatedAt     DateTime?
  rewardOpenedAt DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

/// Задание тренера клиенту по упражнению шаблона (режим тренера). Тренер — владелец шаблона.
/// Связь — с упражнением, а не со строкой TemplateExercise: редактор шаблона пересоздаёт строки при сохранении.
model CoachTarget {
  id         String    @id @default(cuid())
  clientId   String
  templateId String
  exerciseId String
  sets       Int?
  reps       Int?
  weight     Float?
  /// шаг прогрессии, кг (0,5…20); null — прогрессии нет
  step       Float?
  /// неудач подряд (прогрессия): на 3-й — разгрузка −10 %
  fails      Int       @default(0)
  /// последняя разгрузка (прогрессия) — сигнал «Застой на весе»
  unloadedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client   User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([clientId, templateId, exerciseId])
  @@index([templateId])
}

enum CoachFormat {
  ONLINE
  OFFLINE
  BOTH
}

/// Публичная страница тренера /trainer/<ник>: видна всем, пока опубликована и режим тренера включён.
model CoachProfile {
  userId      String      @id
  displayName String?
  city        String?
  format      CoachFormat @default(BOTH)
  /// коды из SPECIALTIES (lib/coach/profile.ts)
  specialties String[]    @default([])
  about       String      @default("")
  /// скрытые цифры — коды STAT_CODES
  hiddenStats String[]    @default([])
  publishedAt DateTime?
  /// блок «Награды тренера» на публичной странице
  showAwards  Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([publishedAt])
}

/// Одноразовая ссылка t.me/<бот>?start=<token> для привязки Telegram (15 минут)
model TelegramLinkToken {
  token     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Ограничение подбора пароля: key — "id:<логин или email>" или "ip:<адрес>" (правила — lib/auth/throttle-rules.ts)
model LoginThrottle {
  key         String    @id
  failures    Int
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

enum CoachSignalKind {
  MISSED_PLAN // две последние назначенные тренировки не выполнены
  STALLED // задание не выполняется 2 раза подряд или была разгрузка
  ACTIVITY_DROP // тренировок вдвое меньше обычного
  INACTIVE // 7 дней без тренировок
}

/// Сигнал риска клиента — для уведомления тренеру один раз на появление (показ считается на лету).
/// Один открытый (resolvedAt = null) на тренер + клиент + тип — частичный уникальный индекс CoachSignal_open в миграции.
model CoachSignal {
  id         String          @id @default(cuid())
  coachId    String
  clientId   String
  kind       CoachSignalKind
  since      DateTime
  createdAt  DateTime        @default(now())
  notifiedAt DateTime?
  resolvedAt DateTime?

  coach  User @relation("CoachSignalCoach", fields: [coachId], references: [id], onDelete: Cascade)
  client User @relation("CoachSignalClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@index([coachId, clientId])
}

/// Итоги недели тренера: общие цифры (без персональных данных клиентов).
model CoachWeeklyRecap {
  id        String    @id @default(cuid())
  coachId   String
  /// понедельник "YYYY-MM-DD" в поясе тренера
  week      String
  /// CoachRecapTotals с version
  data      Json
  createdAt DateTime  @default(now())
  /// push отправлен
  pushedAt  DateTime?
  /// тренер открыл
  seenAt    DateTime?

  coach   User               @relation(fields: [coachId], references: [id], onDelete: Cascade)
  clients CoachRecapClient[]

  @@unique([coachId, week])
}

/// Строка клиента в итогах недели тренера.
model CoachRecapClient {
  recapId  String
  clientId String
  /// CoachRecapRow с version
  data     Json

  recap  CoachWeeklyRecap @relation(fields: [recapId], references: [id], onDelete: Cascade)
  client User             @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@id([recapId, clientId])
  @@index([clientId])
}

/// Группа клиентов тренера — метка для фильтра и быстрого выбора; клиент может быть в нескольких
model CoachGroup {
  id        String   @id @default(cuid())
  coachId   String
  name      String
  /// название без учёта регистра и лишних пробелов — уникально у тренера
  nameKey   String
  createdAt DateTime @default(now())

  coach   User               @relation("CoachGroupCoach", fields: [coachId], references: [id], onDelete: Cascade)
  members CoachGroupMember[]

  @@unique([coachId, nameKey])
}

model CoachGroupMember {
  groupId   String
  clientId  String
  createdAt DateTime @default(now())

  group  CoachGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  client User       @relation("CoachGroupClient", fields: [clientId], references: [id], onDelete: Cascade)

  @@id([groupId, clientId])
  @@index([clientId])
}

/// Гильдия игроков (рейды): до 10 участников, вход по ссылке /guild/join/<code>
model Guild {
  id        String   @id @default(cuid())
  name      String
  /// название без учёта регистра и лишних пробелов — уникально
  nameKey   String   @unique
  /// код значка — GUILD_EMBLEMS
  emblem    String
  /// приглашение; «Сменить ссылку» выдаёт новый
  code      String   @unique
  leaderId  String
  createdAt DateTime @default(now())

  leader  User          @relation("GuildLeader", fields: [leaderId], references: [id], onDelete: Restrict)
  members GuildMember[]
  raids   RaidWeek[]
}

/// Участник гильдии: у игрока одна гильдия (userId — ключ); joinedAt — с него урон в рейд
model GuildMember {
  userId   String   @id
  guildId  String
  joinedAt DateTime @default(now())

  user  User  @relation("GuildMember", fields: [userId], references: [id], onDelete: Cascade)
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
}

/// Рейд гильдии за неделю (спека: docs/superpowers/specs/2026-10-11-raid-boss-design.md).
/// Окно — пн 00:00 … следующий пн 00:00 в поясе главы на момент создания, в UTC; HP фиксируется при создании.
model RaidWeek {
  id                 String    @id @default(cuid())
  guildId            String
  /// понедельник «YYYY-MM-DD» в поясе главы
  week               String
  startsAt           DateTime
  endsAt             DateTime
  bossCode           String
  hp                 Int
  defeatedAt         DateTime?
  mvpUserId          String?
  /// когда ушло напоминание «не хватает урона» (одно на рейд)
  thursdayNotifiedAt DateTime?
  createdAt          DateTime  @default(now())

  guild   Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  mvp     User?        @relation("RaidMvp", fields: [mvpUserId], references: [id], onDelete: SetNull)
  hits    RaidHit[]
  rewards RaidReward[]

  @@unique([guildId, week])
  /// тик напоминаний: рейды текущего окна
  @@index([endsAt])
  /// счётчик MVP (ачивки)
  @@index([mvpUserId])
}

/// Урон одной тренировки по рейду: остаётся и после выхода игрока из гильдии.
model RaidHit {
  id        String   @id @default(cuid())
  raidId    String
  userId    String
  workoutId String   @unique
  damage    Int
  crits     Int
  createdAt DateTime @default(now())

  raid    RaidWeek @relation(fields: [raidId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workout Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([raidId])
  /// итоги недели: мои удары
  @@index([userId])
}

/// Награда из сундука рейда: создаётся при победе каждому бившему участнику.
model RaidReward {
  id        String    @id @default(cuid())
  raidId    String
  userId    String
  xp        Int
  mvp       Boolean   @default(false)
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  raid RaidWeek @relation(fields: [raidId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([raidId, userId])
  /// счётчик побед в рейдах (ачивки)
  @@index([userId])
}

// ───────────────────────────── Личные цели (lib/goals) ─────────────────────────────

enum GoalType {
  STRENGTH // упражнение + метрика RecordType
  WORKOUTS // завершённые тренировки с момента постановки
  STREAK // недели серии (User.currentStreak)
  HOURS // часы в зале с момента постановки
  BODY_WEIGHT // последнее взвешивание
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  FAILED
}

/// Цель хранит условие и стартовое значение; текущее значение считается из данных (lib/goals/queries.ts).
model Goal {
  id            String      @id @default(cuid())
  userId        String
  type          GoalType
  exerciseId    String? // только STRENGTH
  metric        RecordType? // только STRENGTH
  target        Float
  startValue    Float // значение при постановке (полоса «от старта к цели», направление веса)
  deadline      String? // местная дата "YYYY-MM-DD" в User.timeZone
  status        GoalStatus  @default(ACTIVE)
  createdAt     DateTime    @default(now())
  achievedAt    DateTime? // из тренировки — её finishedAt
  closedAt      DateTime? // когда стала ACHIEVED/FAILED
  chestOpenedAt DateTime?
  reminderAt    DateTime? // «7 дней до срока» отправлено

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  /// тик сроков: активные по дате срока (processGoals, lib/goals/tick.ts)
  @@index([status, deadline])
}

/// Журнал взвешиваний: одна запись на местный день; последняя дублируется в User.bodyWeight.
model BodyWeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String // местная дата "YYYY-MM-DD"
  weight    Float // кг, 30…300
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// День посещения кабинета (местный день пользователя) — метрики админки (lib/admin/metrics-queries.ts).
model UserVisit {
  userId String
  day    DateTime @db.Date
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@index([day])
}

// ───────────────────────────── Системные оповещения ─────────────────────────────
// Спека: docs/superpowers/specs/2026-10-18-system-alerts-design.md

enum SystemAlertKind {
  BANNER
  POPUP
}

enum SystemAlertTone {
  INFO
  WARNING
  CRITICAL
}

/// NEVER — без крестика (только строка), SESSION — до закрытия вкладки, FOREVER — запись SystemAlertDismissal.
enum SystemAlertDismiss {
  NEVER
  SESSION
  FOREVER
}

/// Оповещение от админа всем в кабинете (/admin/alerts).
model SystemAlert {
  id         String                 @id @default(cuid())
  kind       SystemAlertKind
  tone       SystemAlertTone        @default(INFO)
  /// обязателен у POPUP, у BANNER не используется
  title      String?
  body       String
  ctaLabel   String?
  ctaHref    String?
  dismiss    SystemAlertDismiss     @default(FOREVER)
  startsAt   DateTime
  /// null — пока не выключат
  endsAt     DateTime?
  enabled    Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  /// логин админа, создавшего оповещение
  createdBy  String?
  dismissals SystemAlertDismissal[]

  @@index([enabled, startsAt])
}

/// Кто закрыл оповещение навсегда; служебная запись (в «Мои данные» не входит).
model SystemAlertDismissal {
  alertId   String
  userId    String
  createdAt DateTime    @default(now())
  alert     SystemAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([alertId, userId])
  @@index([userId])
}

// ───────────────────────────── Обратная связь ─────────────────────────────
// Спека: docs/superpowers/specs/2026-10-18-feedback-design.md

enum FeedbackKind {
  BUG
  IDEA
  OTHER
}

enum FeedbackStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

/// Обращение пользователя админу (/feedback → /admin/feedback); данные пользователя — в «Мои данные».
model Feedback {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      FeedbackKind
  body      String
  status    FeedbackStatus @default(NEW)
  /// заметка админа — автору не показывается и не выгружается
  adminNote String?
  /// путь, откуда открыли форму (без query)
  page      String?
  /// APP_VERSION на момент отправки
  version   String?
  /// обрезан до 300 символов
  userAgent String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ───────────────────────────── Фича-флаги ─────────────────────────────

/// Состояние флага из реестра lib/flags/registry.ts; нет строки — выключен. enabled = false — выключен для всех (kill switch).
model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  /// доля пользователей 0…100 (стабильно по userId — lib/flags/eval.ts)
  percent   Int      @default(0)
  /// всегда включён этим пользователям (при enabled)
  userIds   String[] @default([])
  updatedAt DateTime @updatedAt
  /// логин админа, менявшего последним
  updatedBy String?
}

/// Клубы залов (спека: docs/superpowers/specs/2026-10-12-clubs-design.md).
enum ClubStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Club {
  id           String     @id @default(cuid())
  /// 3–60
  name         String
  /// clubKey(name) — похожие; не уникален (сети залов)
  nameKey      String
  /// 2–40, как ввёл заявитель (модератор может поправить)
  city         String
  /// clubKey(city) — поиск и подсказки
  cityKey      String
  /// 5–120
  address      String
  /// clubKey(address) — похожие
  addressKey   String
  /// телефон/сайт зала — видит только админ приложения
  contact      String
  /// приглашение, алфавит кода друга
  code         String     @unique
  adminId      String
  status       ClubStatus @default(PENDING)
  rejectReason String?
  reviewedAt   DateTime?
  /// «О зале» на публичной странице, до 1000 (lib/club/public.ts)
  about        String     @default("")
  /// транслит названия и города — ставятся при первой публикации и больше не меняются
  slug         String?
  citySlug     String?
  /// публичная страница /gym/<citySlug>/<slug> опубликована
  publishedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt

  admin   User         @relation("ClubAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  members ClubMember[]
  bans    ClubBan[]
  tasks   ClubTask[]

  @@unique([citySlug, slug])
  @@index([status, cityKey])
  @@index([adminId])
  @@index([publishedAt, citySlug])
}

/// Участник клуба: один клуб на человека.
model ClubMember {
  userId   String   @id
  clubId   String
  joinedAt DateTime @default(now())

  user User @relation("ClubMember", fields: [userId], references: [id], onDelete: Cascade)
  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@index([clubId])
}

/// Исключённый админом клуба: не вступит снова до разблокировки.
model ClubBan {
  clubId    String
  userId    String
  createdAt DateTime @default(now())

  club Club @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user User @relation("ClubBan", fields: [userId], references: [id], onDelete: Cascade)

  @@id([clubId, userId])
}

/// Задания клуба (спека: docs/superpowers/specs/2026-10-12-club-tasks-design.md).
enum ClubTaskType {
  WORKOUTS
  VOLUME
  REPS
  HOURS
}

enum ClubTaskMode {
  CLUB
  EACH
}

model ClubTask {
  id             String       @id @default(cuid())
  clubId         String
  type           ClubTaskType
  mode           ClubTaskMode
  /// только для REPS
  exerciseId     String?
  /// базовые единицы: тренировки, кг, повторы, минуты (HOURS)
  target         Int
  /// окно в UTC: полночь дня старта … конец последнего дня в поясе админа на момент создания
  startsAt       DateTime
  endsAt         DateTime
  /// участников на момент создания — для минимума цели CLUB
  membersAtStart Int
  createdById    String?
  cancelledAt    DateTime?
  /// только CLUB: момент выполнения (ставится один раз)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())

  club      Club             @relation(fields: [clubId], references: [id], onDelete: Cascade)
  exercise  Exercise?        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("ClubTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  hits      ClubTaskHit[]
  rewards   ClubTaskReward[]

  @@index([clubId, endsAt])
}

/// Вклад одной тренировки в задание.
model ClubTaskHit {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  workoutId String
  amount    Int
  createdAt DateTime @default(now())

  task    ClubTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User     @relation("ClubTaskHit", fields: [userId], references: [id], onDelete: Cascade)
  workout Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@unique([taskId, workoutId])
  @@index([taskId, userId])
}

/// Сундук за задание: EACH — выполнившему, CLUB — вышедшим на порог вклада.
model ClubTaskReward {
  id        String    @id @default(cuid())
  taskId    String
  userId    String
  openedAt  DateTime?
  createdAt DateTime  @default(now())

  task ClubTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User     @relation("ClubTaskReward", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId, openedAt])
}

/// Мониторинг ошибок (спека: docs/superpowers/specs/2026-10-15-error-monitoring-design.md).
enum ErrorSource {
  SERVER
  CLIENT
}

model ErrorGroup {
  id          String       @id @default(cuid())
  fingerprint String       @unique
  source      ErrorSource
  message     String
  stack       String?
  /// последний путь, где случилась
  path        String?
  count       Int          @default(0)
  /// разных пользователей среди сохранённых событий — считается при записи
  users       Int          @default(0)
  firstSeen   DateTime     @default(now())
  lastSeen    DateTime     @default(now())
  /// версия приложения последнего события
  version     String?
  resolvedAt  DateTime?
  /// когда в последний раз оповестили в Telegram — не чаще раза в час на группу
  alertedAt   DateTime?
  events      ErrorEvent[]

  @@index([resolvedAt, lastSeen])
}

model ErrorEvent {
  id        String     @id @default(cuid())
  groupId   String
  group     ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  at        DateTime   @default(now())
  path      String?
  userAgent String?
  version   String?
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([groupId, at])
  @@index([at])
}

/// Золотой гоблин — редкая встреча посреди тренировки (спека: docs/superpowers/specs/2026-10-15-golden-goblin-design.md).
model GoblinEncounter {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// одна встреча на тренировку; отменили тренировку (удаление) — встреча удаляется
  workoutId      String    @unique
  workout        Workout   @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  spawnedAt      DateTime
  caughtAt       DateTime?
  rewardOpenedAt DateTime?

  @@index([userId, spawnedAt])
}

// ───────────────────── Программы тренера на несколько недель ─────────────────────

enum ProgramStep {
  PERCENT
  KG
}

/// Программа тренера (библиотека): неделя-шаблон + правило веса. Изменения — только для новых назначений.
model CoachProgram {
  id          String      @id @default(cuid())
  coachId     String
  name        String
  weeks       Int
  stepKind    ProgramStep
  stepValue   Float
  /// разгрузка каждая N-я неделя (3…8); null — без разгрузки
  deloadEvery Int?
  deloadPct   Float       @default(10)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  coach       User                @relation(fields: [coachId], references: [id], onDelete: Cascade)
  days        CoachProgramDay[]
  assignments ProgramAssignment[]

  publishedAt        DateTime?
  catalogDescription String?
  hiddenAt           DateTime?
  hiddenReason       String?
  catalogAssignments ProgramAssignment[] @relation("CatalogProgram")

  @@index([coachId])
  @@index([publishedAt])
}

model CoachProgramDay {
  id          String @id @default(cuid())
  programId   String
  /// 0 — понедельник (как PlanSeries.weekday)
  weekday     Int
  templateId  String
  time        String
  durationMin Int    @default(60)

  program  CoachProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([programId, weekday])
  @@index([templateId])
}

/// Программа, назначенная клиенту: снимок названия и правила. Активная — endedAt = null и не кончился срок.
model ProgramAssignment {
  id          String      @id @default(cuid())
  clientId    String
  /// null — аккаунт тренера удалён
  coachId     String?
  /// null — программа удалена из библиотеки
  programId   String?
  name        String
  /// понедельник старта, "YYYY-MM-DD"
  startDate   String
  weeks       Int
  stepKind    ProgramStep
  stepValue   Float
  deloadEvery Int?
  deloadPct   Float
  endedAt     DateTime?
  /// тренеру отправлено «заканчивается через неделю»
  remindedAt  DateTime?
  createdAt   DateTime    @default(now())
  /// запущена из каталога (самостоятельно, coachId = null); null — назначил тренер
  catalogProgramId String?
  /// запущена из каталога — постоянный признак (catalogProgramId обнуляется, если автор удалил программу)
  fromCatalog      Boolean  @default(false)

  client  User          @relation("ProgramAssignmentClient", fields: [clientId], references: [id], onDelete: Cascade)
  coach   User?         @relation("ProgramAssignmentCoach", fields: [coachId], references: [id], onDelete: SetNull)
  program CoachProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  catalogProgram CoachProgram? @relation("CatalogProgram", fields: [catalogProgramId], references: [id], onDelete: SetNull)
  bases   ProgramBase[]
  series  PlanSeries[]

  @@index([clientId, endedAt])
  @@index([coachId, endedAt])
  @@index([catalogProgramId, endedAt])
}

/// Базовый вес упражнения шаблона в назначении; fromWeek — с какой недели действует («Изменить базу»).
model ProgramBase {
  assignmentId String
  templateId   String
  exerciseId   String
  weight       Float
  fromWeek     Int    @default(1)

  assignment ProgramAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@id([assignmentId, templateId, exerciseId])
}

model WhoopConnection {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whoopUserId  String   @unique // user_id WHOOP (int64 строкой) — поиск по вебхуку
  accessToken  String // AES-256-GCM, lib/whoop/crypto.ts
  refreshToken String // AES-256-GCM
  expiresAt    DateTime
  scopes       String   @default("") // выданные scope через пробел
  consentAt    DateTime // время согласия на обработку данных о здоровье
  needsReauth  Boolean  @default(false) // refresh отклонён — нужно переподключить
  lastSyncAt   DateTime? // ограничение «Обновить» — раз в 60 с
  createdAt    DateTime @default(now())
}

model WhoopWorkout {
  id         String   @id // UUID активности WHOOP
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  start      DateTime
  end        DateTime
  sportName  String
  scoreState String // SCORED | PENDING_SCORE | UNSCORABLE
  strain     Float?
  avgHr      Int?
  maxHr      Int?
  kilojoule  Float?
  zonesMs    Int[] // 6 значений: зоны 0…5, мс
  updatedAt  DateTime @updatedAt

  @@index([userId, start])
}

model WhoopSleep {
  id                 String   @id // uuid сна WHOOP
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycleId            String // int64 строкой
  start              DateTime
  end                DateTime
  sleepScoreState    String // SCORED | PENDING_SCORE | UNSCORABLE
  sleepMs            Int? // лёгкий + глубокий + быстрый сон
  needMs             Int? // сумма sleep_needed
  performancePct     Int?
  recoveryScoreState String? // null — восстановления ещё нет
  recoveryPct        Int?
  restingHr          Int?
  hrvMs              Float?
  calibrating        Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  @@index([userId, end])
}
