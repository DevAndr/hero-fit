# PostgreSQL (docker compose up -d)
DATABASE_URL="postgresql://herofit:herofit@localhost:5432/herofit?schema=public"

# JWT — сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Публичный адрес сайта: ссылки в письмах, canonical, sitemap, Open Graph. Индексация поисковиками включается только
# при NODE_ENV=production и не-localhost адресе (lib/seo.ts → isIndexable)
APP_URL="http://localhost:3000" #hero-fit.ru

# Почта (восстановление пароля). Без SMTP_HOST письма печатаются в консоль сервера
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Hero Fit <no-reply@hero-fit.local>"

# Web Push (VAPID). Сгенерировать: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@hero-fit.local"

# Фоновая отправка уведомлений: встроенный интервал в процессе Next.js ("on"/"off")
# и секрет для внешнего cron: GET /api/cron/notifications с заголовком Authorization: Bearer <CRON_SECRET>
NOTIFICATIONS_WORKER="on"
CRON_SECRET=""

# Ежедневный сундук: "off" — не открывать диалог сам на дашборде (только значок в шапке)
DAILY_CHEST_AUTOOPEN="on"
