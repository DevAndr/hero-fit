# /opt/hero-fit/.env на сервере (не коммитить). Читают docker compose (подстановки) и контейнеры app/migrate.

# Домен без схемы — для Caddy; APP_URL — тот же адрес с https (ссылки в письмах, canonical, sitemap).
# Если меняешь APP_URL — поменяй и переменную PROD_APP_URL в GitLab (она вшивается в сборку).
DOMAIN=hero-fit.ru
APP_URL=https://hero-fit.ru

# База (контейнер db). Пароль — длинный случайный: openssl rand -base64 32 | tr -d '/+='
POSTGRES_USER=herofit
POSTGRES_PASSWORD=
POSTGRES_DB=herofit
DATABASE_URL=postgresql://herofit:<POSTGRES_PASSWORD>@db:5432/herofit?schema=public

# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))" — для каждого свой
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Почта для восстановления пароля. Без SMTP_HOST письма только печатаются в лог контейнера app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Hero Fit <no-reply@hero-fit.ru>"

# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@hero-fit.ru

NOTIFICATIONS_WORKER=on
CRON_SECRET=
DAILY_CHEST_AUTOOPEN=on

# Telegram-бот (необязательно): токен и имя — из @BotFather, секрет — 32+ символа (openssl rand -hex 32).
# После деплоя зарегистрировать webhook — см. README, «Telegram-бот».
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# WHOOP (необязательно): Client ID и Client Secret — из кабинета developer.whoop.com, ключ шифрования токенов (32 байта base64):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# WHOOP_TOKEN_KEY не менять — иначе все подключения придётся переподключать. Настройка — README, «WHOOP».
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_TOKEN_KEY=
